{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One shared classroom EKS; one 8GB worker; no NAT, no SSH",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Default": "vpc-0b4718526b088dd9b"
    },
    "PublicSubnets": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Default": "subnet-0acb6bbac7d18223f,subnet-05307aef95ca85c1a"
    },
    "GithubProviderArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "ClusterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "eks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
        ]
      }
    },
    "NodeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
          "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly",
          "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy"
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::EKS::Cluster",
      "Properties": {
        "Name": "classroom-main",
        "Version": "1.36",
        "RoleArn": {
          "Fn::GetAtt": [
            "ClusterRole",
            "Arn"
          ]
        },
        "UpgradePolicy": {
          "SupportType": "STANDARD"
        },
        "AccessConfig": {
          "AuthenticationMode": "API_AND_CONFIG_MAP",
          "BootstrapClusterCreatorAdminPermissions": true
        },
        "ResourcesVpcConfig": {
          "SubnetIds": {
            "Ref": "PublicSubnets"
          },
          "EndpointPrivateAccess": true,
          "EndpointPublicAccess": true,
          "PublicAccessCidrs": [
            "0.0.0.0/0"
          ]
        },
        "Logging": {
          "ClusterLogging": {
            "EnabledTypes": [
              {
                "Type": "api"
              },
              {
                "Type": "audit"
              },
              {
                "Type": "authenticator"
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "Purpose",
            "Value": "week11-shared-team1-team8"
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 1
          },
          "CreditSpecification": {
            "CpuCredits": "standard"
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 30,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ]
        }
      }
    },
    "Nodes": {
      "Type": "AWS::EKS::Nodegroup",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "NodegroupName": "classroom-shared",
        "NodeRole": {
          "Fn::GetAtt": [
            "NodeRole",
            "Arn"
          ]
        },
        "Subnets": {
          "Ref": "PublicSubnets"
        },
        "InstanceTypes": [
          "t3.large"
        ],
        "AmiType": "AL2023_x86_64_STANDARD",
        "CapacityType": "ON_DEMAND",
        "ScalingConfig": {
          "MinSize": 1,
          "DesiredSize": 1,
          "MaxSize": 1
        },
        "LaunchTemplate": {
          "Id": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "UpdateConfig": {
          "MaxUnavailable": 1
        },
        "Labels": {
          "purpose": "classroom"
        },
        "Tags": {
          "Environment": "main",
          "Purpose": "week11-shared-team1-team8"
        }
      }
    },
    "PrivateRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        }
      }
    },
    "GatewaySg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Only the classroom Lightsail reverse proxy reaches the internal NLB",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "172.26.7.237/32"
          }
        ]
      }
    },
    "GatewayNlb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "classroom-main-gateway",
        "Type": "network",
        "Scheme": "internal",
        "Subnets": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "GatewaySg"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "load_balancing.cross_zone.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "GatewayTargets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "TCP",
        "Port": 30080,
        "TargetType": "instance",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPath": "/healthz",
        "HealthCheckPort": "30080",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "GatewayListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "GatewayNlb"
        },
        "Port": 80,
        "Protocol": "TCP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "GatewayTargets"
            }
          }
        ]
      }
    },
    "AllowGatewayNodes": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "Cluster",
            "ClusterSecurityGroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 30080,
        "ToPort": 30080,
        "SourceSecurityGroupId": {
          "Ref": "GatewaySg"
        }
      }
    },
    "GithubRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "classroom-github-main-example",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GithubProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:MinQDU014/idea-support-server:environment:main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ExampleImageAndClusterOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:DescribeImages"
                  ],
                  "Resource": "arn:aws:ecr:ap-southeast-2:950177940921:repository/idea-support-server"
                },
                {
                  "Effect": "Allow",
                  "Action": "eks:DescribeCluster",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Cluster",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "GithubAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "PrincipalArn": {
          "Fn::GetAtt": [
            "GithubRole",
            "Arn"
          ]
        },
        "Type": "STANDARD",
        "KubernetesGroups": [
          "classroom:team"
        ]
      }
    },
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": "ap-southeast-2a",
        "CidrBlock": "172.31.48.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "classroom-main-internal-a"
          }
        ]
      }
    },
    "PrivateRouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetA"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "PrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": "ap-southeast-2b",
        "CidrBlock": "172.31.49.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "classroom-main-internal-b"
          }
        ]
      }
    },
    "PrivateRouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetB"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    }
  },
  "Outputs": {
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "GithubRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GithubRole",
          "Arn"
        ]
      }
    },
    "NodeGroup": {
      "Value": {
        "Ref": "Nodes"
      }
    },
    "GatewayDns": {
      "Value": {
        "Fn::GetAtt": [
          "GatewayNlb",
          "DNSName"
        ]
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "GatewayTargets"
      }
    }
  }
}
